{
  "name": "@cortana/desktop",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tauri build --no-bundle",
    "build:release": "tauri build",
    "bundle:mac": "tauri build --bundles app --no-sign --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "dev": "tauri dev",
    "info": "tauri info",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
