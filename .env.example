# Real environment variables parsed by the Cortana runtime.
# Everything else is configured in config.toml (see config.example.toml);
# the Rust binary only reads the variables below (directly or as the env
# names referenced by api_key_env / token_env entries).

# Rust CLI: --config (src/main.rs)
CORTANA_CONFIG=

# Python connectors: default --token-env values (src/cortana/connectors)
CORTANA_GOOGLE_TOKEN=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Env names wired through api_key_env / token_env in config.toml
CORTANA_EMBEDDING_API_KEY=
CORTANA_QUERY_API_KEY=
CORTANA_SHARED_AGENT_TOKEN=
