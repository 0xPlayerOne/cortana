{
  "name": "cortana-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6"
  },
  "scripts": {
    "build": "bun run --cwd apps/web build",
    "desktop:build": "bun run --cwd apps/desktop build",
    "desktop:build:release": "bun run --cwd apps/desktop build:release",
    "desktop:bundle:mac": "bun run --cwd apps/desktop bundle:mac",
    "desktop:check": "bun run --cwd apps/desktop check",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:info": "bun run --cwd apps/desktop info",
    "desktop:test": "bun run --cwd apps/desktop test",
    "desktop:test:native": "bun run --cwd apps/desktop test:native",
    "dev": "bun run --cwd apps/web dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint apps/web/src",
    "test": "bun test --isolate --max-concurrency=1",
    "typecheck": "bun run --cwd apps/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1"
  }
}
