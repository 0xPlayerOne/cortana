# Generate with: openssl rand -base64 48
CORTANA_OWNER_TOKEN=replace-with-a-random-token
# Optional only when config.toml selects an approved authenticated embedding provider.
CORTANA_EMBEDDING_API_KEY=
# Pin a release tag for upgrades and rollback, for example v0.54.0.
CORTANA_VERSION=latest
# Required only with compose.tls.yaml.
CORTANA_DOMAIN=cortana.example.com
