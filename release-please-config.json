{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "ci",
      "section": "CI"
    },
    {
      "type": "refactor",
      "section": "Maintenance"
    },
    {
      "type": "chore",
      "section": "Maintenance"
    }
  ],
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "cortana"
    }
  },
  "extra-files": [
    {
      "type": "toml",
      "path": "pyproject.toml",
      "jsonpath": "$.project.version"
    },
    {
      "type": "generic",
      "path": "uv.lock"
    },
    {
      "type": "json",
      "path": "apps/web/package.json",
      "jsonpath": "$.version"
    },
    {
      "type": "json",
      "path": "apps/desktop/package.json",
      "jsonpath": "$.version"
    },
    {
      "type": "toml",
      "path": "apps/desktop/src-tauri/Cargo.toml",
      "jsonpath": "$.package.version"
    },
    {
      "type": "generic",
      "path": "apps/desktop/src-tauri/Cargo.lock"
    },
    {
      "type": "json",
      "path": "apps/desktop/src-tauri/tauri.conf.json",
      "jsonpath": "$.version"
    },
    {
      "type": "generic",
      "path": "bun.lock"
    },
    {
      "type": "generic",
      "path": "src/cortana/__init__.py"
    }
  ]
}
